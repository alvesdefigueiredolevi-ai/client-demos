    .nav-link {
      color: var(--color-black);
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      position: relative;
      padding: 6px 0;
      transition: color 0.2s ease;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 1.5px;
      background-color: var(--color-coral);
      transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav-link:hover {
      color: var(--color-coral);
    }
    .nav-link:hover::after {
      width: 100%;
    }

    /* Mobile Menu Toggle */
    .mobile-menu-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      background: none;
      border: 1px solid rgba(23, 23, 23, 0.15);
      border-radius: 50%;
      cursor: pointer;
      padding: 0;
    }
    @media (min-width: 900px) {
      .mobile-menu-btn {
        display: none;
      }
    }
    .mobile-menu-btn span {
      display: block;
      width: 18px;
      height: 1.5px;
      background-color: var(--color-black);
      transition: all 0.25s ease;
    }
    .mobile-menu-btn[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }
    .mobile-menu-btn[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu-btn[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }

    /* Mobile Navigation Overlay */
    .mobile-nav-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(23, 23, 23, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 99;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .mobile-nav-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .mobile-nav-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: 88vw;
      max-width: 380px;
      height: 100vh;
      background-color: var(--bg-ivory);
      z-index: 100;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px 28px;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.15);
      overflow-y: auto;
    }
    .mobile-nav-overlay.active .mobile-nav-drawer {
      transform: translateX(0);
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      min-height: calc(100vh - 100px);
      min-height: calc(100dvh - 100px);
      display: flex;
      align-items: flex-end;
      padding-top: 40px;
      padding-bottom: 70px;
      background-color: var(--color-black);
      overflow: hidden;
    }
    @media (max-width: 768px) {
      .hero-section {
        min-height: auto;
        padding-bottom: 90px;
      }
    }

    /* Ken Burns Animation */
    .hero-bg-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
    }
    .hero-bg-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 25%;
      filter: brightness(0.88) contrast(1.05);
      transform-origin: center center;
      animation: kenBurnsSlow 18s ease-in-out infinite alternate;
    }
    @keyframes kenBurnsSlow {
      0% {
        transform: scale(1) translate(0, 0);
      }
      100% {
        transform: scale(1.09) translate(-1%, -1.5%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-bg-image {
        animation: none !important;
      }
      .strand-line path {
        stroke-dashoffset: 0 !important;
        animation: none !important;
      }
      * {
        animation-duration: 0.001s !important;
        transition-duration: 0.001s !important;
      }
    }

    .hero-overlay-gradient {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(23, 23, 23, 0.4) 0%, rgba(23, 23, 23, 0.15) 40%, rgba(23, 23, 23, 0.75) 100%);
      z-index: 2;
    }

    /* Oversized Magazine Typography behind content */
    .hero-magazine-backdrop {
      position: absolute;
      top: 8%;
      right: 4%;
      z-index: 3;
      pointer-events: none;
      user-select: none;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      opacity: 0.18;
      mix-blend-mode: overlay;
    }
    .hero-backdrop-text {
      font-family: var(--font-display);
      font-size: clamp(4.5rem, 14vw, 15rem);
      line-height: 0.85;
      color: var(--color-white);
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }

    /* Hair Strand SVG Animation */
    .hero-strand-svg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 4;
      pointer-events: none;
    }
    .hair-strand-path {
      stroke: var(--color-blush);
      stroke-width: 1.5;
      stroke-linecap: round;
      fill: none;
      opacity: 0.6;
      stroke-dasharray: 2000;
      stroke-dashoffset: 2000;
      animation: drawStrand 6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.4s;
    }
    .hair-strand-path-coral {
      stroke: var(--color-coral);
      stroke-width: 1.2;
      stroke-linecap: round;
      fill: none;
      opacity: 0.45;
      stroke-dasharray: 1800;
      stroke-dashoffset: 1800;
      animation: drawStrand 8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.8s;
    }
    @keyframes drawStrand {
      to {
        stroke-dashoffset: 0;
      }
    }

    /* Live booking pulse */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-black);
      background-color: rgba(255, 255, 255, 0.75);
      border: 1px solid rgba(23, 23, 23, 0.1);
      padding: 6px 12px;
      border-radius: 9999px;
      margin-bottom: 16px;
      backdrop-filter: blur(4px);
    }
    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--color-coral);
      position: relative;
    }
    .pulse-dot::after {
      content: '';
      position: absolute;
      top: -3px;
      left: -3px;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      border: 1.5px solid var(--color-coral);
      animation: coralPulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    }
    @keyframes coralPulse {
      0% {
        transform: scale(0.5);
        opacity: 1;
      }
      100% {
        transform: scale(2);
        opacity: 0;
      }
    }

    /* Editorial Overlapping Panel */
    .hero-editorial-panel {
      position: relative;
      z-index: 5;
      background-color: rgba(245, 240, 232, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 12px;
      padding: 36px 32px;
      max-width: 580px;
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.3);
      animation: heroPanelFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @media (min-width: 768px) {
      .hero-editorial-panel {
        padding: 48px 44px;
      }
    }
    @keyframes heroPanelFadeUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .eyebrow-tag {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.18em;
